<div class="color-{{ section.settings.color_scheme }} gradient"><div class="aliens-section page-width" style="--section-top: {{ section.settings.padding_top }}px; --section-bottom: {{ section.settings.padding_bottom }}px">{% render 'aliens-editorial', section: section %}</div></div>
{% schema %}
{
  "name": "t:aliens.brand_manifesto.name",
  "tag": "section",
  "class": "aliens-section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:aliens.brand_manifesto.settings_0_label",
      "default": "ALIENS / A DIFFERENT PERSPECTIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:aliens.brand_manifesto.settings_1_label",
      "default": "NOT MADE TO BLEND IN."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:aliens.brand_manifesto.settings_2_label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:aliens.brand_manifesto.settings_3_label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:aliens.brand_manifesto.settings_4_label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:aliens.brand_manifesto.settings_5_label"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:aliens.brand_manifesto.settings_6_label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:aliens.brand_manifesto.settings_7_label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:aliens.brand_manifesto.settings_8_label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:aliens.brand_manifesto.settings_9_label",
      "options": [
        {
          "value": "left",
          "label": "t:aliens.brand_manifesto.settings_9_options_0_label"
        },
        {
          "value": "right",
          "label": "t:aliens.brand_manifesto.settings_9_options_1_label"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "large_type",
      "label": "t:aliens.brand_manifesto.settings_10_label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.brand_manifesto.settings_11_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:aliens.brand_manifesto.settings_12_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:aliens.brand_manifesto.settings_13_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:aliens.brand_manifesto.presets_0_name"
    }
  ]
}
{% endschema %}
