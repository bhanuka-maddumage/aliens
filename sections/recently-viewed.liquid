{{ 'aliens-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aliens-products.js' | asset_url }}" defer="defer"></script>
<aliens-recently-viewed
  class="color-{{ section.settings.color_scheme }} gradient"
  data-store="{{ shop.permanent_domain | escape }}"
  data-enabled="{{ settings.aliens_recently_viewed }}"
  data-current="{{ product.handle | escape }}"
  data-root="{{ routes.root_url }}"
  data-limit="{{ section.settings.limit }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-currency-code="{{ settings.currency_code_enabled }}"
  data-from="{{ 'products.product.price.from_price_html' | t: price: '[price]' | strip_html | escape }}"
  {% unless request.design_mode %}hidden{% endunless %}
>
  <div class="page-width aliens-product-section" style="--aliens-product-padding: {{ section.settings.padding }}px; --aliens-recent-columns: {{ section.settings.columns }}">
    <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    <ul class="aliens-recent-grid" role="list" data-recent-grid></ul>
    {% if request.design_mode %}<p class="aliens-product-empty" data-recent-empty>Enable recently viewed in theme settings to use this section. Product history appears only when Shopify's privacy API allows analytics processing. The current product is excluded. Empty history is hidden from shoppers.</p>{% endif %}
  </div>
</aliens-recently-viewed>
{% schema %}
{
  "name": "t:aliens.recently_viewed.name",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:aliens.recently_viewed.settings_0_label",
      "default": "BACK IN YOUR ORBIT."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:aliens.recently_viewed.settings_1_label",
      "default": "h1",
      "options": [
        {
          "value": "h2",
          "label": "t:aliens.recently_viewed.settings_1_options_0_label"
        },
        {
          "value": "h1",
          "label": "t:aliens.recently_viewed.settings_1_options_1_label"
        },
        {
          "value": "h0",
          "label": "t:aliens.recently_viewed.settings_1_options_2_label"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "t:aliens.recently_viewed.settings_2_content"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:aliens.recently_viewed.settings_3_label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:aliens.recently_viewed.settings_4_label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.recently_viewed.settings_5_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:aliens.recently_viewed.settings_6_label",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:aliens.recently_viewed.presets_0_name"
    }
  ]
}
{% endschema %}
