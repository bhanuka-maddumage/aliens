{{ 'aliens-interactive.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #Aliens-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 }}px; }
  @media (min-width: 750px) { #Aliens-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <section id="Aliens-{{ section.id }}" class="aliens-section page-width" aria-labelledby="AliensHeading-{{ section.id }}">
    <header class="aliens-interactive-heading">
      {% if section.settings.eyebrow != blank %}<p class="aliens-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="AliensHeading-{{ section.id }}" class="aliens-title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="aliens-text rte">{{ section.settings.text }}</div>{% endif %}
    </header>
    <script src="{{ 'aliens-interactive.js' | asset_url }}" defer="defer"></script>
    <aliens-carousel>
      <div id="AliensTrack-{{ section.id }}" class="aliens-carousel-track" data-carousel-track tabindex="0" role="region" aria-labelledby="AliensHeading-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == '@app' %}<div class="aliens-review-card">{% render block %}</div>
          {% elsif block.settings.quote != blank %}
            <article class="aliens-review-card" {{ block.shopify_attributes }}>
              {% if block.settings.rating > 0 %}<p class="aliens-review-rating"><span aria-hidden="true">{% for star in (1..block.settings.rating) %}★{% endfor %}</span><span class="visually-hidden">{{ block.settings.rating }} / 5</span></p>{% endif %}
              <blockquote class="rte">{{ block.settings.quote }}</blockquote>
              {% if block.settings.author != blank %}<p class="aliens-review-author">{{ block.settings.author | escape }}</p>{% endif %}
              {% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>{% endif %}
            </article>
          {% elsif request.design_mode %}<div class="aliens-review-card aliens-editor-note" {{ block.shopify_attributes }}>Add an approved customer review. No sample ratings or testimonials are shown to shoppers.</div>{% endif %}
        {% endfor %}
      </div>
      <div class="aliens-carousel-controls" data-carousel-controls hidden>
        <button type="button" data-carousel-prev aria-controls="AliensTrack-{{ section.id }}">{{ section.settings.previous_label | escape }}</button>
        <button type="button" data-carousel-next aria-controls="AliensTrack-{{ section.id }}">{{ section.settings.next_label | escape }}</button>
      </div>
    </aliens-carousel>
  </section>
</div>
{% schema %}
{
  "presets": [
    {
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ],
      "name": "t:aliens.reviews_carousel.presets_0_name"
    }
  ],
  "settings": [
    {
      "type": "text",
      "label": "t:aliens.reviews_carousel.settings_0_label",
      "id": "eyebrow"
    },
    {
      "default": "FROM YOUR ORBIT.",
      "type": "text",
      "label": "t:aliens.reviews_carousel.settings_1_label",
      "id": "heading"
    },
    {
      "type": "richtext",
      "label": "t:aliens.reviews_carousel.settings_2_label",
      "id": "text"
    },
    {
      "default": "scheme-1",
      "type": "color_scheme",
      "label": "t:aliens.reviews_carousel.settings_3_label",
      "id": "color_scheme"
    },
    {
      "min": 0,
      "max": 120,
      "label": "t:aliens.reviews_carousel.settings_4_label",
      "type": "range",
      "step": 4,
      "default": 64,
      "unit": "px",
      "id": "padding_top"
    },
    {
      "min": 0,
      "max": 120,
      "label": "t:aliens.reviews_carousel.settings_5_label",
      "type": "range",
      "step": 4,
      "default": 64,
      "unit": "px",
      "id": "padding_bottom"
    },
    {
      "content": "t:aliens.reviews_carousel.settings_6_content",
      "type": "paragraph"
    },
    {
      "default": "Previous",
      "type": "text",
      "label": "t:aliens.reviews_carousel.settings_7_label",
      "id": "previous_label"
    },
    {
      "default": "Next",
      "type": "text",
      "label": "t:aliens.reviews_carousel.settings_8_label",
      "id": "next_label"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "tag": "div",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "settings": [
        {
          "type": "richtext",
          "label": "t:aliens.reviews_carousel.blocks_1_settings_0_label",
          "id": "quote"
        },
        {
          "type": "text",
          "label": "t:aliens.reviews_carousel.blocks_1_settings_1_label",
          "id": "author"
        },
        {
          "max": 5,
          "id": "rating",
          "step": 1,
          "default": 0,
          "min": 0,
          "type": "range",
          "label": "t:aliens.reviews_carousel.blocks_1_settings_2_label"
        },
        {
          "type": "product",
          "label": "t:aliens.reviews_carousel.blocks_1_settings_3_label",
          "id": "product"
        }
      ],
      "name": "t:aliens.reviews_carousel.blocks_1_name"
    }
  ],
  "name": "t:aliens.reviews_carousel.name",
  "max_blocks": 12,
  "class": "aliens-custom-section"
}
{% endschema %}
