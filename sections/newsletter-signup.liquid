<div class="color-{{ section.settings.color_scheme }} gradient"><div class="aliens-section page-width" style="--section-top: {{ section.settings.padding_top }}px; --section-bottom: {{ section.settings.padding_bottom }}px"><div class="aliens-newsletter"><div class="aliens-section-heading" data-aliens-reveal>
{% if section.settings.eyebrow != blank %}<p class="aliens-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
{% if section.settings.heading != blank %}<h2 class="aliens-title">{{ section.settings.heading | escape }}</h2>{% endif %}
{% if section.settings.text != blank %}<div class="aliens-text rte">{{ section.settings.text }}</div>{% endif %}</div><div>
{% assign newsletter_id = 'AliensNewsletter-' | append: section.id %}
{% form 'customer', id: newsletter_id %}
<input type="hidden" name="contact[tags]" value="newsletter">
<label for="Email-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
<div class="aliens-newsletter__field"><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}" {% if form.errors %}aria-invalid="true" aria-describedby="EmailError-{{ section.id }}"{% endif %}><button type="submit" aria-label="{{ 'newsletter.button_label' | t }}">↗</button></div>
{% if form.errors %}<div role="alert" id="EmailError-{{ section.id }}">{{ form.errors | default_errors }}</div>{% endif %}
{% if form.posted_successfully? %}<p role="status">{{ 'newsletter.success' | t }}</p>{% endif %}
{% endform %}
{% if section.settings.note != blank %}<div class="aliens-newsletter__note rte">{{ section.settings.note }}</div>{% endif %}
</div></div></div></div>
{% schema %}
{
  "name": "t:aliens.newsletter_signup.name",
  "tag": "section",
  "class": "aliens-section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:aliens.newsletter_signup.settings_0_label",
      "default": "ALIENS / A DIFFERENT PERSPECTIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:aliens.newsletter_signup.settings_1_label",
      "default": "TRANSMISSIONS FROM ALIENS."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:aliens.newsletter_signup.settings_2_label"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "t:aliens.newsletter_signup.settings_3_label",
      "default": "<p>Product launches, new perspectives and updates. Unsubscribe at any time.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.newsletter_signup.settings_4_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:aliens.newsletter_signup.settings_5_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:aliens.newsletter_signup.settings_6_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:aliens.newsletter_signup.presets_0_name"
    }
  ]
}
{% endschema %}
