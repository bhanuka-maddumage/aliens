<div class="color-{{ section.settings.color_scheme }} gradient"><div class="aliens-section page-width" style="--section-top: {{ section.settings.padding_top }}px; --section-bottom: {{ section.settings.padding_bottom }}px"><div class="aliens-promo"><div class="aliens-section-heading" data-aliens-reveal>
{% if section.settings.eyebrow != blank %}<p class="aliens-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
{% if section.settings.heading != blank %}<h2 class="aliens-title">{{ section.settings.heading | escape }}</h2>{% endif %}
{% if section.settings.text != blank %}<div class="aliens-text rte">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="aliens-button" href="{{ section.settings.link }}">{{ section.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div></div></div>
{% schema %}
{
  "name": "t:aliens.promotional_banner.name",
  "tag": "section",
  "class": "aliens-section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:aliens.promotional_banner.settings_0_label",
      "default": "ALIENS / A DIFFERENT PERSPECTIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:aliens.promotional_banner.settings_1_label",
      "default": "A NEW PERSPECTIVE STARTS HERE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:aliens.promotional_banner.settings_2_label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:aliens.promotional_banner.settings_3_label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:aliens.promotional_banner.settings_4_label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.promotional_banner.settings_5_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:aliens.promotional_banner.settings_6_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:aliens.promotional_banner.settings_7_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:aliens.promotional_banner.presets_0_name"
    }
  ]
}
{% endschema %}
