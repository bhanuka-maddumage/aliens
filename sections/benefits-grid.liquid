<div class="color-{{ section.settings.color_scheme }} gradient"><div class="aliens-section page-width" style="--section-top: {{ section.settings.padding_top }}px; --section-bottom: {{ section.settings.padding_bottom }}px"><div class="aliens-section-heading" data-aliens-reveal>
{% if section.settings.eyebrow != blank %}<p class="aliens-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
{% if section.settings.heading != blank %}<h2 class="aliens-title">{{ section.settings.heading | escape }}</h2>{% endif %}
{% if section.settings.text != blank %}<div class="aliens-text rte">{{ section.settings.text }}</div>{% endif %}</div><div class="aliens-benefits">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="aliens-eyebrow">{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="aliens-text-link">{{ block.settings.label | escape }} ↗</a>{% endif %}</div>{% endfor %}</div></div></div>
{% schema %}
{
  "name": "t:aliens.benefits_grid.name",
  "tag": "section",
  "class": "aliens-section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:aliens.benefits_grid.settings_0_label",
      "default": "ALIENS / A DIFFERENT PERSPECTIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:aliens.benefits_grid.settings_1_label",
      "default": "GOOD TO KNOW."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:aliens.benefits_grid.settings_2_label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.benefits_grid.settings_3_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:aliens.benefits_grid.settings_4_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:aliens.benefits_grid.settings_5_label",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:aliens.benefits_grid.blocks_0_name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:aliens.benefits_grid.blocks_0_settings_0_label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:aliens.benefits_grid.blocks_0_settings_1_label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:aliens.benefits_grid.blocks_0_settings_2_label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:aliens.benefits_grid.blocks_0_settings_3_label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:aliens.benefits_grid.presets_0_name"
    }
  ]
}
{% endschema %}
