{{ 'aliens-products.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign feature_product = section.settings.product | default: product
  assign feature_image = section.settings.image | default: feature_product.featured_image
-%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width aliens-product-section" style="--aliens-product-padding: {{ section.settings.padding }}px">
    <div class="aliens-technical{% if section.settings.image_right %} aliens-technical--image-right{% endif %}">
      <div class="aliens-technical__media">
        {% if feature_image != blank %}
          {{ feature_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div>
        {% if section.settings.eyebrow != blank %}<p class="aliens-technical__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        <div class="aliens-technical__features">
          {% for block in section.blocks %}
            {% if block.settings.heading != blank and block.settings.text != blank %}
              <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
                <summary>{{ block.settings.heading | escape }}</summary>
                <div class="rte">{{ block.settings.text }}</div>
              </details>
            {% endif %}
          {% endfor %}
          {% if section.settings.show_metafields and feature_product != blank %}
            {% assign feature_keys = 'material,fit,weight,certification' | split: ',' %}
            {% assign feature_labels = 'Material,Fit,Weight,Certification' | split: ',' %}
            {% for key in feature_keys %}
              {% assign field = feature_product.metafields.custom[key] %}
              {% if field != blank %}
                <details><summary>{{ feature_labels[forloop.index0] }}</summary><div class="rte">{{ field | metafield_tag }}</div></details>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% if feature_product != blank and section.settings.button_label != blank %}
          <a class="button button--primary" href="{{ feature_product.url }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
        {% if request.design_mode and feature_product == blank and section.blocks.size == 0 %}
          <p class="aliens-product-empty">Select a product or add feature blocks. Include only verified product information.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:aliens.helmet_feature_showcase.name",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:aliens.helmet_feature_showcase.settings_0_label",
      "info": "t:aliens.helmet_feature_showcase.settings_0_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:aliens.helmet_feature_showcase.settings_1_label",
      "info": "t:aliens.helmet_feature_showcase.settings_1_info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:aliens.helmet_feature_showcase.settings_2_label",
      "default": "A closer look"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:aliens.helmet_feature_showcase.settings_3_label",
      "default": "DETAILS MAKE THE DIFFERENCE."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:aliens.helmet_feature_showcase.settings_4_label",
      "default": "h1",
      "options": [
        {
          "value": "h2",
          "label": "t:aliens.helmet_feature_showcase.settings_4_options_0_label"
        },
        {
          "value": "h1",
          "label": "t:aliens.helmet_feature_showcase.settings_4_options_1_label"
        },
        {
          "value": "h0",
          "label": "t:aliens.helmet_feature_showcase.settings_4_options_2_label"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:aliens.helmet_feature_showcase.settings_5_label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:aliens.helmet_feature_showcase.settings_6_label",
      "default": "Explore the product"
    },
    {
      "type": "checkbox",
      "id": "show_metafields",
      "label": "t:aliens.helmet_feature_showcase.settings_7_label",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:aliens.helmet_feature_showcase.settings_8_content"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:aliens.helmet_feature_showcase.settings_9_label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:aliens.helmet_feature_showcase.settings_10_label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:aliens.helmet_feature_showcase.settings_11_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:aliens.helmet_feature_showcase.settings_12_label",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:aliens.helmet_feature_showcase.blocks_0_name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:aliens.helmet_feature_showcase.blocks_0_settings_0_label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:aliens.helmet_feature_showcase.blocks_0_settings_1_label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:aliens.helmet_feature_showcase.presets_0_name"
    }
  ]
}
{% endschema %}
